{
  "permissions": {
    "allow": [
      "Bash(git -C /Users/philipp/Code/dataraum/dataraum-eval push origin main)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format \"$CLAUDE_FILE_PATH\" --quiet 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/end-of-turn-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
